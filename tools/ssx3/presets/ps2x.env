# Android base preset for a local SSX 3 build (shipped with tools/ssx3).
# Derived from the Odin play env with every private path removed: no host
# paths, no personal card, no remaster pack, no Tricky staging,
# no telemetry files. The SET2 settings overlay is on.
# Place it with: build.py install (SHA checked; preserves cards).
# Online is on (Brad 10-16): the main-menu Quick Play row pairs two
# 120 Hz players through ssx.bradr.dev (state sync; races relay through the
# server, no peer IPs). Needs the "SSX 3 · 120" launcher; at 60 the row
# only explains. Point PS2X_NET_SERVER at another lobby to self-host.
PS2X_NETSYNC=1
PS2X_NET_SERVER=ssx.bradr.dev
PS2X_CD_IMAGE=/storage/emulated/0/Android/data/com.ssx3.recomp/files/SSX3.iso
PS2X_MC_ROOT=/storage/emulated/0/Android/data/com.ssx3.recomp/files/mc0
PS2X_SETTINGS_OVERLAY=1
PS2X_VU0_RECOMP=0
GE1_VK_TURNIP=auto
PS2X_AUDIO_RESAMPLE=sinc
PS2X_VIF1_REVERSE_DMA=lagF
GE1_UPSCALE=auto
PS2X_GE1_EXPORT_SIZE=auto
GE1_CAS=auto
PS2X_GS_WAKE_LOWWATER=4096
PS2X_MTVU_STAGE_PARK2=1
# device-gates-1 (H5): TU_AUTOTUNE_ALGO left to the GPU-aware backend, which
# sets prefer_sysmem only when the bundled Turnip serves an Adreno 8xx
# (TUR1: Elysium -0.75 p50/-2.0 p99, pixels identical). Explicit env wins.
WAIT_SPIN_MICROSECONDS=5
PS2X_GS_GIF_BATCH=1
PS2X_GS_GIF_ARENA=1
PS2X_SSX3_NATIVE_WORLD=terrain,instances
PS2X_VIF_UNPACK_FAST=1
GE1_ADRENO_SRC1_REWRITE=1
GE1_MERGE_SKIP=1
GE1_EXPORT_DIRECT=1
PS2X_PRESENT_PREROTATE=2
PS2X_PRESENT_AHB_POOL=6
PS2X_TURBO_BOOT=1
