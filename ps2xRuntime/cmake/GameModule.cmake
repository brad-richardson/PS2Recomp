# module-seam-1: attach a game module to a final target (runner or test
# binary); see include/runtime/game_module.h. The module target sets
#   PS2X_GAME_MODULE_ENTRY   function returning `const ps2_game_module::Module &`
#   PS2X_GAME_MODULE_HEADER  header declaring it (on the module's include path)
# The generated glue TU defines ps2_game_module::linkedModule() in <target>
# itself, so the module is kept and selected by an explicit reference, never
# by a static constructor or archive order. One module per target.
function(ps2x_attach_game_module target module)
    get_target_property(_entry ${module} PS2X_GAME_MODULE_ENTRY)
    get_target_property(_header ${module} PS2X_GAME_MODULE_HEADER)
    if(NOT _entry OR NOT _header)
        message(FATAL_ERROR "ps2x_attach_game_module: ${module} lacks PS2X_GAME_MODULE_ENTRY/HEADER")
    endif()
    get_target_property(_attached ${target} PS2X_ATTACHED_GAME_MODULE)
    if(_attached)
        message(FATAL_ERROR "ps2x_attach_game_module: ${target} already has ${_attached}")
    endif()
    set(_glue "${CMAKE_CURRENT_BINARY_DIR}/ps2x_game_module_glue_${target}.cpp")
    file(GENERATE OUTPUT "${_glue}" CONTENT
"// Generated by ps2x_attach_game_module(${target} ${module}).
#include \"${_header}\"

const ps2_game_module::Module *ps2_game_module::linkedModule() noexcept
{
    return &${_entry}();
}
")
    target_sources(${target} PRIVATE "${_glue}")
    set_source_files_properties("${_glue}" TARGET_DIRECTORY ${target} PROPERTIES
        GENERATED ON
        SKIP_UNITY_BUILD_INCLUSION ON
        SKIP_PRECOMPILE_HEADERS ON)
    target_link_libraries(${target} PRIVATE ${module})
    set_target_properties(${target} PROPERTIES PS2X_ATTACHED_GAME_MODULE ${module})
    message(STATUS "PS2X: game module ${module} attached to ${target}")
endfunction()
