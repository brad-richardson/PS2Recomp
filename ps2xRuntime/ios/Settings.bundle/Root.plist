<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- I25: iOS Settings -> SSX3 PS2X. "autoRoute" is read by
     src/lib/ps2_ios_runtime.mm (CFPreferences); unset = off (IG1: a fresh
     install waits at the title for real input; test legs pass the script). Off clears
     PS2X_PAD_SCRIPT so a controller drives the game. I26: "virtualControls"
     (unset = on); off sets PS2X_VIRTUAL_PAD=0. Copied into the .app
     at staging (local/research/I25/build-install.sh). IQ1: "target120"
     (unset = on, CFG1 D2: full 120 is the default) layers the bundled
     full120.env over ps2x.env at launch; Documents/ps2x.env still wins
     over both. -->
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Check-in mode</string>
			<key>FooterText</key>
			<string>On: the app plays itself from the title to Select Character and a race. Off: use a paired controller. Takes effect the next time the app starts.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Auto-route</string>
			<key>Key</key>
			<string>autoRoute</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Touch</string>
			<key>FooterText</key>
			<string>On-screen D-pad, face buttons, shoulders, Start and Select. Hidden automatically once you use a connected game controller. Takes effect the next time the app starts.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Virtual controls</string>
			<key>Key</key>
			<string>virtualControls</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Frame rate</string>
			<key>FooterText</key>
			<string>On: races run the whole game at 120 updates a second with a 120 Hz display where the screen supports it (menus stay at 60). If the device can't keep up, the race slows down. Off: the normal 60. Takes effect the next time the app starts.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Target 120 fps (full-120 events)</string>
			<key>Key</key>
			<string>target120</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
