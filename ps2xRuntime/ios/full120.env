# IQ1: iOS full-120 preset (the Odin FH5 preset's full-120 keys,
# ~/dev/ssx3-work/odin-play/presets/full120.env). Layered over the bundled
# ps2x.env when Settings > SSX3 PS2X > Target 120 fps is on; Documents/ps2x.env
# still wins. Copied into the .app at staging (ios_build.sh).
# Full 120 only while a race event runs (stock 60 in boot/menus/loading/pause).
PS2X_SSX3_SIM_MODE=stock
PS2X_SSX3_FULL120=events
PS2X_SSX3_FULL120_FIX=all
# ProMotion request (inert on a 60 Hz panel) + one present per guest VSync.
PS2X_DISPLAY_HZ=120
PS2X_PRESENT_PER_VSYNC=1
# IP6: GT3's once-computed full-120 hook predicates (the Odin 120 layer has it;
# same hooks, same order, same results; -0.25..0.5 ms EE per update there).
PS2X_SSX3_FULL120_FASTHOOKS=1
# IP6: PX1-style vsync lock on the CADisplayLink grid (guest VBlank on the panel's
# real refresh; also lifts raylib's loop cap 5 % above the panel so the swap alone
# paces presents) with the Odin 120 layer's audio pair (AU15 tempo, AU16 demand feed).
PS2X_VSYNC_LOCK=1
PS2X_VSYNC_LOCK_AUDIO=tempo
PS2X_STRETCH_FEED=demand
